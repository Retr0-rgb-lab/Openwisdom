{
  "name": "@openwisdom/core",
  "version": "0.1.0",
  "private": true,
  "description": "Openwisdom shared non-interactive install/catalog APIs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@openwisdom/providers": "workspace:*",
    "@openwisdom/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
