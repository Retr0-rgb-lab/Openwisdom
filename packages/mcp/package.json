{
  "name": "openwisdom-mcp",
  "version": "0.1.1",
  "description": "Openwisdom MCP server — stdio skill package manager for coding agents (search/list/get/install/update, no LLM)",
  "type": "module",
  "bin": {
    "openwisdom-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "catalog-snapshot",
    "skills-snapshot",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "keywords": [
    "openwisdom",
    "mcp",
    "agent-skills",
    "model-context-protocol",
    "claude-code",
    "cursor"
  ],
  "author": "Openwisdom contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retr0-rgb-lab/Openwisdom.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://openwisdom.vercel.app",
  "bugs": {
    "url": "https://github.com/Retr0-rgb-lab/Openwisdom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@openwisdom/core": "workspace:*",
    "@openwisdom/providers": "workspace:*",
    "@openwisdom/schema": "workspace:*",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
